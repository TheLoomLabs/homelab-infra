# {{ ansible_managed }}
# Stack "{{ alerting_stack_name }}": Traefik, ntfy, healthchecks (ADR 0011).
services:
  traefik:
    image: {{ alerting_traefik_image }}
    command:
      - --providers.swarm.endpoint=unix:///var/run/docker.sock
      - --providers.swarm.exposedByDefault=false
      - --providers.swarm.network={{ alerting_edge_network }}
      - --entrypoints.web.address=:80
      - --entrypoints.web.http.redirections.entrypoint.to=websecure
      - --entrypoints.web.http.redirections.entrypoint.scheme=https
      - --entrypoints.websecure.address=:443
      # One wildcard certificate, like the Kubernetes Gateway: no lab
      # hostnames in the public certificate transparency logs.
      - --entrypoints.websecure.http.tls.certresolver=le
      - --entrypoints.websecure.http.tls.domains[0].main={{ alerting_domain }}
      - --entrypoints.websecure.http.tls.domains[0].sans=*.{{ alerting_domain }}
      - --certificatesresolvers.le.acme.caserver={{ alerting_acme_server }}
      - --certificatesresolvers.le.acme.storage=/acme/acme.json
      - --certificatesresolvers.le.acme.dnschallenge.provider=cloudflare
      - --certificatesresolvers.le.acme.dnschallenge.resolvers={{ alerting_acme_resolvers }}
      - --ping=true
      - --log.level=INFO
      - --global.checknewversion=false
      - --global.sendanonymoususage=false
    environment:
      CF_DNS_API_TOKEN_FILE: /run/secrets/cloudflare_api_token
    ports:
      - {target: 80, published: 80, protocol: tcp, mode: ingress}
      - {target: 443, published: 443, protocol: tcp, mode: ingress}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - traefik-acme:/acme
    secrets:
      - cloudflare_api_token
    networks:
      - {{ alerting_edge_network }}
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 30s
      timeout: 5s
      retries: 3
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.role == manager
          - node.labels.homelab.alerting == true
      resources:
        limits:
          memory: 256M

  ntfy:
    image: {{ alerting_ntfy_image }}
    command: ["serve", "--config", "/run/secrets/ntfy_server"]
    volumes:
      - ntfy-data:/var/lib/ntfy
    secrets:
      - ntfy_server
    networks:
      - {{ alerting_edge_network }}
    healthcheck:
      test: ["CMD-SHELL", "wget -q --tries=1 -O- http://localhost:80/v1/health | grep -q '\"healthy\":true'"]
      interval: 30s
      timeout: 5s
      retries: 3
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.labels.homelab.alerting == true
      resources:
        limits:
          memory: 128M
      labels:
        - traefik.enable=true
        - traefik.http.routers.ntfy.rule=Host(`{{ alerting_ntfy_host }}`)
        - traefik.http.routers.ntfy.entrypoints=websecure
        - traefik.http.services.ntfy.loadbalancer.server.port=80

  healthchecks:
    image: {{ alerting_healthchecks_image }}
    environment:
      SITE_ROOT: https://{{ alerting_healthchecks_host }}
      SITE_NAME: Lab healthchecks
      ALLOWED_HOSTS: {{ alerting_healthchecks_host }}
      SECRET_KEY_FILE: /run/secrets/healthchecks_secret_key
      DB: sqlite
      DB_NAME: /data/hc.sqlite
      DEBUG: "False"
      REGISTRATION_OPEN: "False"
      SECURE_PROXY_SSL_HEADER: HTTP_X_FORWARDED_PROTO,https
      # ntfy resolves to a private lab address.
      INTEGRATIONS_ALLOW_PRIVATE_IPS: "True"
      UWSGI_PROCESSES: "2"
    volumes:
      - healthchecks-data:/data
    secrets:
      - healthchecks_secret_key
    networks:
      - {{ alerting_edge_network }}
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.labels.homelab.alerting == true
      resources:
        limits:
          memory: 384M
      labels:
        - traefik.enable=true
        - traefik.http.routers.healthchecks.rule=Host(`{{ alerting_healthchecks_host }}`)
        - traefik.http.routers.healthchecks.entrypoints=websecure
        - traefik.http.services.healthchecks.loadbalancer.server.port=8000

volumes:
  traefik-acme:
  ntfy-data:
  healthchecks-data:

networks:
  {{ alerting_edge_network }}:
    external: true

secrets:
  cloudflare_api_token:
    external: true
    name: {{ alerting_secrets.cloudflare_api_token.name }}
  ntfy_server:
    external: true
    name: {{ alerting_secrets.ntfy_server.name }}
  healthchecks_secret_key:
    external: true
    name: {{ alerting_secrets.healthchecks_secret_key.name }}
