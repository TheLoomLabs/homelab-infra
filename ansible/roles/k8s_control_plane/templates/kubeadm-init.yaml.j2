# {{ ansible_managed }}
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ ansible_host }}
  bindPort: 6443
nodeRegistration:
  name: {{ inventory_hostname }}
  criSocket: unix:///run/containerd/containerd.sock
  kubeletExtraArgs:
    - name: node-ip
      value: {{ ansible_host }}
# Per-node patches for the static pods (control-plane metrics on the node
# address, docs/monitoring.md). Upgrades need --patches with the same path.
patches:
  directory: {{ k8s_control_plane_patches_dir }}
# Cilium replaces kube-proxy entirely.
skipPhases:
  - addon/kube-proxy
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: {{ cluster_name }}
controlPlaneEndpoint: {{ k8s_api_vip }}:6443
networking:
  podSubnet: {{ pod_cidr }}
  serviceSubnet: {{ service_cidr }}
  dnsDomain: {{ cluster_dns_domain }}
apiServer:
  certSANs:
    - {{ k8s_api_vip }}
    - k8s-api.{{ lab_dns_domain }}
{% for host in groups['k8s_control_plane'] %}
    - {{ hostvars[host].ansible_host }}
    - {{ host }}
{% endfor %}
  # Encryption at rest (docs/encryption.md). Joining control-plane nodes read
  # this from the kubeadm-config ConfigMap; the role places the file first.
  # Pod Security defaults for unlabelled namespaces (docs/pod-security.md),
  # placed the same way.
  extraArgs:
    - name: encryption-provider-config
      value: {{ k8s_control_plane_encryption_config }}
    - name: admission-control-config-file
      value: {{ k8s_control_plane_admission_config }}
  extraVolumes:
    - name: encryption-config
      hostPath: {{ k8s_control_plane_encryption_dir }}
      mountPath: {{ k8s_control_plane_encryption_dir }}
      readOnly: true
      pathType: DirectoryOrCreate
    - name: admission-config
      hostPath: {{ k8s_control_plane_admission_dir }}
      mountPath: {{ k8s_control_plane_admission_dir }}
      readOnly: true
      pathType: DirectoryOrCreate
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
serverTLSBootstrap: false
