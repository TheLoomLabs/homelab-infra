# {{ ansible_managed }}
# kube-vip in ARP mode: floats the API server VIP between control-plane nodes.
apiVersion: v1
kind: Pod
metadata:
  name: kube-vip
  namespace: kube-system
spec:
  containers:
    - name: kube-vip
      image: ghcr.io/kube-vip/kube-vip:{{ kube_vip_version }}
      imagePullPolicy: IfNotPresent
      args: ["manager"]
      env:
        - {name: vip_arp, value: "true"}
        - {name: port, value: "6443"}
        - {name: vip_interface, value: "{{ ansible_facts['default_ipv4']['interface'] }}"}
        - {name: vip_subnet, value: "32"}
        - {name: dns_mode, value: "first"}
        - {name: cp_enable, value: "true"}
        - {name: cp_namespace, value: "kube-system"}
        - {name: svc_enable, value: "false"}
        - {name: vip_leaderelection, value: "true"}
        - {name: vip_leasename, value: "plndr-cp-lock"}
        - {name: vip_leaseduration, value: "5"}
        - {name: vip_renewdeadline, value: "3"}
        - {name: vip_retryperiod, value: "1"}
        - {name: address, value: "{{ k8s_api_vip }}"}
        - {name: prometheus_server, value: ":2112"}
      securityContext:
        capabilities:
          add: ["NET_ADMIN", "NET_RAW"]
      volumeMounts:
        - name: kubeconfig
          mountPath: /etc/kubernetes/admin.conf
  hostAliases:
    - hostnames: ["kubernetes"]
      ip: 127.0.0.1
  hostNetwork: true
  volumes:
    - name: kubeconfig
      hostPath:
        # During 'kubeadm init' admin.conf has no RBAC yet, so the first node
        # bootstraps with super-admin.conf and is switched over afterwards.
        path: {{ k8s_control_plane_kube_vip_kubeconfig }}
