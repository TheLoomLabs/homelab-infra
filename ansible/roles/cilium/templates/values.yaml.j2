# {{ ansible_managed }}
# Helm values for Cilium. This file is the full source of truth: the role runs
# `cilium upgrade --reset-values` with it whenever it changes.
kubeProxyReplacement: true

# Spelled out so an upgrade can't change it: the cilium CLI derives the name
# from the kubeconfig on a first install, `--reset-values` falls back to
# "default". The agents run as "default"; changing it would give every pod a
# new security identity. Not the kubeadm clusterName ({{ cluster_name }}).
cluster:
  name: default
k8sServiceHost: {{ k8s_api_vip }}
k8sServicePort: 6443

ipam:
  mode: kubernetes

operator:
  replicas: 2
  # Restart the operator when its config changes.
  rollOutPods: true

# Restart the agents when the cilium-config ConfigMap changes, so new settings
# (like the ones below) take effect without a manual rollout.
rollOutCiliumPods: true

# LoadBalancer services: LB IPAM hands out IPs from CiliumLoadBalancerIPPool
# objects (kubernetes/platform/cilium-lb), and L2 announcements answer ARP for
# them on the LAN. Every announced service holds a Kubernetes lease, so the
# agents need a higher API client rate limit than the default 5 QPS / 10 burst.
l2announcements:
  enabled: true
k8sClientRateLimit:
  qps: 20
  burst: 40

# Gateway API: Cilium's Envoy serves the Gateways in kubernetes/platform/gateway.
# The role installs the Gateway API CRDs first. Each Gateway gets its own
# LoadBalancer service, so its address comes from the LB IPAM pool above.
gatewayAPI:
  enabled: true
  gatewayClass:
    create: true

hubble:
  relay:
    enabled: true
  ui:
    enabled: true
  # mTLS between the Hubble servers in the agents and Hubble Relay. The
  # chart's default "helm" method creates the certificates once and reuses
  # them on every upgrade, so they expire after a year. A CronJob (certgen)
  # issues them at install time and renews them every four months. Not
  # cert-manager: it is installed later, by Argo CD.
  tls:
    auto:
      method: cronJob
      schedule: "0 0 1 */4 *"
