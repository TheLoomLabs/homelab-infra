# {{ ansible_managed }}
# Helm values for Cilium. Changes after the first install are applied with
# `cilium upgrade --values` (or later, by Argo CD).
kubeProxyReplacement: true
k8sServiceHost: {{ k8s_api_vip }}
k8sServicePort: 6443

ipam:
  mode: kubernetes

operator:
  replicas: 2

hubble:
  relay:
    enabled: true
  ui:
    enabled: true
