# {{ ansible_managed }}
# Stack "{{ uptime_kuma_stack_name }}": Uptime Kuma (docs/uptime.md).
services:
  kuma:
    image: {{ uptime_kuma_image }}
    environment:
      # SQLite in the data volume. Set here, the setup wizard skips the
      # database step and only asks for the admin account.
      UPTIME_KUMA_DB_TYPE: sqlite
    volumes:
      - kuma-data:/app/data
    networks:
      - {{ uptime_kuma_edge_network }}
    # The image has its own healthcheck (extra/healthcheck, every 60s).
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.labels.homelab.uptime == true
      # Never two containers on the same SQLite file.
      update_config:
        order: stop-first
      resources:
        limits:
          memory: 512M
      labels:
        - traefik.enable=true
        - traefik.http.routers.uptime.rule=Host(`{{ uptime_kuma_host }}`)
        - traefik.http.routers.uptime.entrypoints=websecure
        - traefik.http.services.uptime.loadbalancer.server.port=3001

volumes:
  kuma-data:

networks:
  {{ uptime_kuma_edge_network }}:
    external: true
