# {{ ansible_managed }}
# restic repository and R2 credentials for swarm-backup (role swarm_backup).
RESTIC_REPOSITORY=s3:https://{{ swarm_backup_r2_account_id }}.r2.cloudflarestorage.com/{{ swarm_backup_bucket }}
RESTIC_PASSWORD_FILE=/etc/swarm-backup/restic-password
RESTIC_CACHE_DIR=/var/cache/restic
AWS_ACCESS_KEY_ID={{ swarm_backup_r2_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ swarm_backup_r2_secret_access_key }}
AWS_DEFAULT_REGION=auto
