{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/.schema/devbox.schema.json",
  "packages": {
    "terraform":                                                                    "latest",
    "tflint":                                                                       "latest",
    "ansible":                                                                      "latest",
    "ansible-lint":                                                                 "latest",
    "yamllint":                                                                     "latest",
    "kubectl":                                                                      "latest",
    "kubernetes-helm":                                                              "latest",
    "cilium-cli":                                                                   "latest",
    "hubble":                                                                       "latest",
    "k9s":                                                                          "latest",
    "kubeconform":                                                                  "latest",
    "python":                                                                       "3.12",
    "sops":                                                                         "latest",
    "age":                                                                          "latest",
    "pre-commit":                                                                   "latest",
    "jq":                                                                           "latest",
    "yq-go":                                                                        "latest",
    "shellcheck":                                                                   "latest",
    "gnumake":                                                                      "latest",
    "gitleaks":                                                                     "latest",
    "trivy":                                                                        "latest",
    "dig":                                                                          "latest",
    "restic":                                                                       "latest",
    "libargon2":                                                                    "latest",
    "sqlite":                                                                       "latest",
    "github:NixOS/nixpkgs/f20cd90e28fe0403873f473b29e42662cd86e8c4#prometheus.cli": "",
    "github:NixOS/nixpkgs/f20cd90e28fe0403873f473b29e42662cd86e8c4#grafana-loki":   ""
  },
  "env": {
    "KUBECONFIG":        "$PWD/.artifacts/kubeconfig",
    "ANSIBLE_CONFIG":    "$PWD/ansible/ansible.cfg",
    "TF_CLI_ARGS_plan":  "-compact-warnings",
    "SOPS_AGE_KEY_FILE": "$PWD/.artifacts/age.key"
  },
  "shell": {
    "init_hook": [
      "mkdir -p .artifacts",
      "[ -f .env ] && set -a && . ./.env && set +a || true",
      "echo 'homelab-infra devbox ready. Run: make help'"
    ],
    "scripts": {
      "setup": "make setup",
      "lint":  "make lint",
      "plan":  "make tf-plan",
      "apply": "make tf-apply",
      "site":  "make site"
    }
  }
}
